# API
APP_ENV=dev
LOG_LEVEL=INFO

# Exchange
CRYPTOCOM_EXCHANGE_BASE_URL=https://api.crypto.com/exchange/v1
QUOTE_CCY=USDT
MAX_UNIVERSE_SIZE=200
MAX_CONCURRENT_REQUESTS=25
HTTP_TIMEOUT_S=10

# Alerts
ALERT_LOOKBACK_HOURS=24
MAX_ENTRY_ALERTS_24H=5
MAX_EXIT_ALERTS_24H=5
MAX_TOTAL_ALERTS_24H=10

# Candles / ingestion
CANDLE_TIMEFRAME=1m
CANDLE_BACKFILL_COUNT=180
CANDLE_POLL_COUNT=2
# Wait a couple seconds after the minute boundary.
CANDLE_FETCH_DELAY_S=2
# Keep enough history in memory for features.
CANDLE_BUFFER_SIZE=300
# Prune old 1m candles daily.
CANDLE_RETENTION_DAYS=30
CANDLE_PRUNE_INTERVAL_HOURS=24
DB_UPSERT_BATCH_SIZE=5000

# Signal engine thresholds
DVZ_MIN=1.5
EXTENSION_MAX=0.08
MIN_DV_1M_USD=10000
SPREAD_MAX=0.005
BOOK_CHECK_TOP_N=20
SIGNALS_RETURN_LIMIT=50

# State machine thresholds + cooldowns
ENTRY_SCORE_THRESHOLD=0.80
EXIT_SCORE_THRESHOLD=0.55
STALL_MINUTES=10
STALL_DVZ_MAX=1.0
GLOBAL_ENTRY_COOLDOWN_MIN=10
SYMBOL_ENTRY_COOLDOWN_MIN=90
SYMBOL_EXIT_COOLDOWN_MIN=30
MAX_ENTRY_ALERTS_PER_SCAN=1

# Slack notifier (Incoming Webhook URL)
# Leave unset to disable Slack.
# SLACK_WEBHOOK_URL=
# SLACK_CHANNEL_NAME=

# Admin (optional). If set, requires X-Admin-Token header for POST /config.
# ADMIN_TOKEN=

# Database (local machine)
# For docker-compose app container, this is overridden to use host "db".
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crypto_momentum
